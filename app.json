{
  "expo": {
    "name": "Nubapay Business",
    "slug": "nubapay-business",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nubapaybusiness",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.nubapay-business.ios",
      "supportsTablet": true,
      "requireFullScreen": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "NB Business"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.nubapay.business"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a0f",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Nubapay usa Face ID para que ingreses sin escribir tu contraseña."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nubapay usa tus fotos para que puedas subir la imagen de tus productos.",
          "cameraPermission": "Nubapay usa la cámara para escanear los QR de entradas y pedidos, y para sacarle fotos a tus productos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Nubapay usa la cámara para escanear los QR de entradas y pedidos, y para sacarle fotos a tus productos.",
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Nubapay usa Face ID para que ingreses sin escribir tu contraseña."
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#0069ff",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "./plugins/with-widget-assets",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.nubapay-business.ios.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.nubapay-business.ios",
          "frequentUpdates": true,
          "widgets": [
            {
              "name": "EventPulse",
              "displayName": "Pulso del evento",
              "description": "Lo recaudado y las entradas vendidas de tu evento.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "src/widgets/EventPulseWidget.tsx"
              },
              "android": null
            }
          ],
          "enablePushNotifications": true
        }
      ],
      "expo-quick-actions",
      "expo-background-task",
      [
        "./plugins/with-android-app-label",
        {
          "label": "NB Business"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
