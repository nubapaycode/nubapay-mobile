{
  "expo": {
    "name": "Nubapay Business",
    "slug": "nubapay-business",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nubapaybusiness",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.nubapay.business"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080b11",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.nubapay.business"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080b11",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nubapay usa tus fotos para que puedas subir la imagen de tus productos.",
          "cameraPermission": "Nubapay usa la cámara para escanear los QR de entradas y pedidos, y para sacarle fotos a tus productos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Nubapay usa la cámara para escanear los QR de entradas y pedidos, y para sacarle fotos a tus productos.",
          "recordAudioAndroid": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
