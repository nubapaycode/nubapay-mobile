# URL base del backend Flask (sin /api al final).
# En un dispositivo físico usá la IP de tu máquina en la red local, no 127.0.0.1.
# En el emulador de Android, 10.0.2.2 apunta al localhost del host.
EXPO_PUBLIC_API_URL=http://127.0.0.1:5001

# Sitio público (tienda de los compradores) para los links "Ver catálogo" / "Ver entradas".
# Si no se define, se usa https://www.nubapay.app.
EXPO_PUBLIC_SITE_URL=https://www.nubapay.app
